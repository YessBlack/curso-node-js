<!DOCTYPE html>
<html lang="es">

<head>
  <title>Login | Mi App</title>
  <%- include('partials/head') %>
    <style>
      body {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
        padding: 2rem;
        background:
          radial-gradient(ellipse at 30% 50%, rgba(108, 99, 255, 0.2) 0%, transparent 60%),
          radial-gradient(ellipse at 80% 20%, rgba(255, 101, 132, 0.12) 0%, transparent 50%),
          var(--bg);
      }

      .auth-wrapper {
        width: 100%;
        max-width: 420px;
      }

      .auth-logo {
        text-align: center;
        margin-bottom: 2rem;
      }

      .auth-logo .logo-icon {
        width: 52px;
        height: 52px;
        background: linear-gradient(135deg, var(--primary), var(--secondary));
        border-radius: 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        margin-bottom: 0.8rem;
      }

      .auth-logo h2 {
        font-size: 1.5rem;
        font-weight: 700;
      }

      .auth-logo p {
        color: var(--muted);
        font-size: 0.9rem;
        margin-top: 4px;
      }

      .auth-card {
        padding: 2rem;
      }

      .btn-full {
        width: 100%;
        margin-top: 8px;
        border-radius: 10px;
        padding: 13px;
      }

      .divider {
        display: flex;
        align-items: center;
        gap: 12px;
        color: var(--muted);
        font-size: 0.82rem;
        margin: 1.2rem 0;
      }

      .divider::before,
      .divider::after {
        content: '';
        flex: 1;
        height: 1px;
        background: var(--border);
      }

      .forgot {
        text-align: right;
        margin-top: -10px;
        margin-bottom: 16px;
      }

      .forgot a {
        font-size: 0.83rem;
        color: var(--primary);
      }

      .forgot a:hover {
        text-decoration: underline;
      }
    </style>
</head>

<body>
  <div class="auth-wrapper">
    <div class="auth-logo">
      <div class="logo-icon">⚡</div>
      <h2>Iniciar Sesión</h2>
      <p>Accede a tu cuenta</p>
    </div>
    <div class="card auth-card">
      <% if (error) { %>
        <div
          style="background:rgba(255,101,132,0.12);border:1px solid rgba(255,101,132,0.3);color:#ff6584;padding:10px 14px;border-radius:8px;font-size:0.88rem;margin-bottom:1rem;">
          ⚠️ <%= error %>
        </div>
        <% } %>
          <form action="/login" method="POST">
            <div class="form-group">
              <label for="username">Usuario</label>
              <input type="text" id="username" name="username" placeholder="Tu nombre de usuario" required />
            </div>
            <div class="form-group">
              <label for="password">Contraseña</label>
              <input type="password" id="password" name="password" placeholder="••••••••" required />
            </div>
            <div class="forgot"><a href="#">¿Olvidaste tu contraseña?</a></div>
            <button type="submit" class="btn btn-primary btn-full">Entrar</button>
          </form>
          <div class="divider">o</div>
          <p class="link-muted" style="text-align:center">
            ¿No tienes cuenta? <a href="/register">Regístrate aquí</a>
          </p>
    </div>
  </div>
</body>

</html>